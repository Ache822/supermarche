# =============================================================================
# Supermarche Master Environment Variables Template
# Copy this file to .env and fill in the required values.
# In GitHub Actions, store these as GitHub Secrets / Repository Variables.
# =============================================================================

# --- General & Deployment Ports ---
NODE_ENV=production
FRONTEND_PORT=80
BACKEND_PORT=3000

# --- Backend Configuration ---
# MongoDB Connection String (Atlas or Hosted Database)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/supermarche?retryWrites=true&w=majority

# JWT Authentication Secret (Must be >= 32 characters in production)
JWT_SECRET=replace_this_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Domain where frontend is hosted)
CORS_ORIGIN=https://supermarche.com

# Email / SMTP Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Supermarche Support <no-reply@supermarche.com>

# Redis (Internal container or external Redis URL)
REDIS_URL=redis://redis:6379

# --- Frontend Configuration (Build Args for Vite) ---
VITE_API_BASE_URL=https://supermarche.com/api/v1
VITE_SOCKET_URL=https://supermarche.com

# --- Cloudflare Tunnel Configuration ---
CLOUDFLARE_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token...

